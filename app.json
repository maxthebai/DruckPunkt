{
  "expo": {
    "name": "DruckPunkt",
    "slug": "druckpunkt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.maxthebai.druckpunkt"
    },
    "android": {
      "package": "de.maxthebai.druckpunkt",
      "adaptiveIcon": {
        "backgroundColor": "#0F7C86",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.POST_NOTIFICATIONS", "android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-sharing", "expo-notifications", "expo-document-picker"]
  }
}
